APP_NAME="PHP com Rapadura"
# PRODUÇÃO: use APP_ENV=production e APP_DEBUG=false (debug=true vaza stack traces e segredos).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados — Docker: host é o nome do serviço "mysql"
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=phpcomrapadura
DB_USERNAME=laravel
DB_PASSWORD=          # Docker usa "secret" como padrão quando vazio
DB_ROOT_PASSWORD=     # Docker usa "secret" como padrão quando vazio

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUÇÃO (HTTPS): defina como true para o cookie de sessão só trafegar por HTTPS.
SESSION_SECURE_COOKIE=false

# Proxies/CDN confiáveis para obter o IP real do cliente (rate limit e HTTPS atrás de LB).
# Vazio = não confia em nenhum proxy (correto para nginx→PHP-FPM direto).
# Atrás de Cloudflare/load balancer, informe os ranges (separados por vírgula) ou "*".
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis — Docker: host é o nome do serviço "redis"
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP2Go — https://app.smtp2go.com/settings/users
# Host: mail.smtp2go.com | Port: 587 (TLS) ou 2525 (alternativa)
# MAIL_USERNAME: domínio verificado ou usuário SMTP2Go
# MAIL_PASSWORD: API key ou senha SMTP gerada no painel SMTP2Go
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contato@phpcomrapadura.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 — armazenamento de imagens de eventos
# CLOUDFLARE_R2_ACCOUNT_ID: encontrado em dash.cloudflare.com → R2 → Overview
# CLOUDFLARE_R2_URL: domínio público do bucket (ex: https://assets.phpcomrapadura.org)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=phpcomrapadura
CLOUDFLARE_R2_URL=

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@phpcomrapadura.org
# Senha do admin inicial. Em produção é obrigatória (a seed aborta se vazia).
# Em ambiente local, se vazia, a seed gera uma senha aleatória e a exibe uma única vez.
ADMIN_PASSWORD=
